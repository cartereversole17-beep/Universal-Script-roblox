local ESPObjects = {}

local function RemoveESP(player)

    local highlight = ESPObjects[player]

    if highlight then
        highlight:Destroy()
        ESPObjects[player] = nil
    end
end

local function CreateESP(player)

    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    RemoveESP(player)

    local highlight = Instance.new("Highlight")

    highlight.Name = "PlesneviyPlayerESP"

    highlight.Adornee = character

    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.FillColor =
        Config.Themes[Config.Theme]

    highlight.FillTransparency = 0.65

    highlight.OutlineColor =
        Color3.fromRGB(255,255,255)

    highlight.OutlineTransparency = 0

    highlight.Parent = Gui

    ESPObjects[player] = highlight
end

local function UpdateESP()

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer then

            if Config.PlayerESP then
                CreateESP(player)
            else
                RemoveESP(player)
            end
        end
    end
end

Players.PlayerAdded:Connect(function(player)

    player.CharacterAdded:Connect(function()

        task.wait(0.2)

        if Config.PlayerESP then
            CreateESP(player)
        end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
end)

--==================================================
-- AIMBOT TARGET SEARCH
--==================================================

local function GetClosestTarget()

    local closestPlayer = nil
    local closestDistance = Config.FOV

    local screenCenter =
        Vector2.new(
            Camera.ViewportSize.X / 2,
            Camera.ViewportSize.Y / 2
        )

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            local character =
                player.Character

            if character then

                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                local head =
                    character:FindFirstChild(
                        "Head"
                    )

                if humanoid
                    and head
                    and humanoid.Health > 0 then

                    local position, visible =
                        Camera:WorldToViewportPoint(
                            head.Position
                        )

                    if visible
                        and position.Z > 0 then

                        local screenPosition =
                            Vector2.new(
                                position.X,
                                position.Y
                            )

                        local distance =
                            (
                                screenPosition -
                                screenCenter
                            ).Magnitude

                        if distance <
                            closestDistance then

                            closestDistance =
                                distance

                            closestPlayer =
                                player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

--==================================================
-- AIMBOT
--==================================================

local AimbotConnection

local function StartAimbot()

    if AimbotConnection then
        AimbotConnection:Disconnect()
    end

    AimbotConnection =
        RunService.RenderStepped:Connect(
        function()

            if not Config.Aimbot then
                return
            end

            local target =
                GetClosestTarget()

            if not target then
                return
            end

            local character =
                target.Character

            if not character then
                return
            end

            local head =
                character:FindFirstChild("Head")

            if not head then
                return
            end

            -- Hold right mouse button to aim.
            if UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton2
            ) then

                local cameraPosition =
                    Camera.CFrame.Position

                local direction =
                    (
                        head.Position -
                        cameraPosition
                    ).Unit

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        CFrame.lookAt(
                            cameraPosition,
                            cameraPosition +
                            direction
                        ),
                        0.18
                    )
            end
        end
    )
end

StartAimbot()

