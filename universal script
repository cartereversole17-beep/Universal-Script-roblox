local FrozenNPCs = {}

local function IsNPC(model)

    if not model:IsA("Model") then
        return false
    end

    if Players:GetPlayerFromCharacter(model) then
        return false
    end

    return model:FindFirstChildOfClass(
        "Humanoid"
    ) ~= nil
end

local function FreezeNPC(model)

    local Hum =
        model:FindFirstChildOfClass(
            "Humanoid"
        )

    if not Hum then
        return
    end

    if not FrozenNPCs[model] then

        FrozenNPCs[model] = {
            WalkSpeed = Hum.WalkSpeed,
            JumpPower = Hum.JumpPower,
            AutoRotate = Hum.AutoRotate
        }
    end

    Hum.WalkSpeed = 0
    Hum.JumpPower = 0
    Hum.AutoRotate = false
end

local function UnfreezeNPC(model)

    local Data =
        FrozenNPCs[model]

    local Hum =
        model:FindFirstChildOfClass(
            "Humanoid"
        )

    if Hum and Data then

        Hum.WalkSpeed =
            Data.WalkSpeed

        Hum.JumpPower =
            Data.JumpPower

        Hum.AutoRotate =
            Data.AutoRotate
    end

    FrozenNPCs[model] = nil
end

RunService.Heartbeat:Connect(function()

    for _, Object in ipairs(
        workspace:GetChildren()
    ) do

        if IsNPC(Object) then

            if Config.FreezeNPC then

                FreezeNPC(Object)

            elseif FrozenNPCs[Object] then

                UnfreezeNPC(Object)
            end
        end
    end
end)

