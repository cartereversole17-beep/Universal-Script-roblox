local MenuVisible = true
local MenuDisabled = false

UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    -- RIGHT ALT:
    -- Toggle the menu on/off
    if input.KeyCode == Enum.KeyCode.RightAlt then

        -- If Right Control permanently disabled
        -- the menu, Right Alt does nothing.
        if MenuDisabled then
            return
        end

        MenuVisible = not MenuVisible
        Main.Visible = MenuVisible
    end

    -- RIGHT CONTROL:
    -- Permanently hide the menu
    if input.KeyCode == Enum.KeyCode.RightControl then

        MenuDisabled = true
        MenuVisible = false

        Main.Visible = false
    end
end)
