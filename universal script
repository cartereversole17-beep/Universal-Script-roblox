--==================================================
-- REPLACE THE AIMBOT CAMERA SECTION
--==================================================

-- Find the existing:
--
-- Camera.CFrame =
--     Camera.CFrame:Lerp(...)
--
-- and replace that section with this:

local smoothness =
    math.clamp(
        Config.AimbotSmoothness / 100,
        0.01,
        1
    )

-- Convert slider into interpolation amount.
-- Lower slider = faster/snappier movement.
-- Higher slider = smoother/slower movement.

local interpolation =
    1 - smoothness

interpolation =
    math.clamp(
        interpolation,
        0.01,
        0.99
    )

Camera.CFrame =
    Camera.CFrame:Lerp(
        CFrame.lookAt(
            cameraPosition,
            head.Position
        ),
        interpolation
    )
